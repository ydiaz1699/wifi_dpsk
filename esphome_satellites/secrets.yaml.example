# secrets.yaml.example — Plantilla de secretos para los nodos ESPHome.
#
# Copia este archivo a esphome_satellites/secrets.yaml y rellena los valores.
# El secrets.yaml real está en .gitignore y NUNCA se versiona.
#
#   cp secrets.yaml.example secrets.yaml

wifi_ssid: "tu_ssid_aqui"
wifi_password: "tu_password_wifi"

mqtt_broker: "192.168.0.10"      # IP del broker MQTT (Debian/HA)
mqtt_user: "usuario_mqtt"
mqtt_pass: "password_mqtt"

ota_password: "cambia_esta_clave_ota"

# Clave de la API nativa de ESPHome (base64, 32 bytes).
# Generar con: openssl rand -base64 32
api_key: "CAMBIA_ESTA_CLAVE_BASE64_DE_32_BYTES"
